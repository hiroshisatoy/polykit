{
	"manifest_version": 3,
	"name": "PolyKit",
	"version": "1.0.1",
	"description": "translate.wordpress.org 向け日本語翻訳ツールキット",
	"homepage_url": "https://github.com/hiroshisatoy/polykit",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "PolyKit メニューを開く",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": {
		"service_worker": "js/background.js"
	},
	"permissions": [
		"activeTab",
		"storage"
	],
	"content_scripts": [
		{
			"js": [
				"js/init.js"
			],
			"css": [
				"css/common.css",
				"css/translation.css",
				"css/settings.css"
			],
			"matches": [
				"*://translate.wordpress.org/*"
			],
			"exclude_matches": [
				"*://translate.wordpress.org/*/playground",
				"*://translate.wordpress.org/*/playground/*"
			]
		},
		{
			"css": [
				"css/wp-plugins.css"
			],
			"matches": [
				"*://translate.wordpress.org/projects/wp-plugins/*"
			],
			"exclude_matches": [
				"*://translate.wordpress.org/*/playground",
				"*://translate.wordpress.org/*/playground/*"
			]
		}
	],
	"host_permissions": [
		"*://translate.wordpress.org/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"js/polykit.js",
				"js/polykit-functions.js",
				"js/polykit-validation.js",
				"js/polykit-locale-validation.js",
				"js/polykit-i18n.js",
				"js/polykit-gp-l10n.js",
				"languages/*/*.json",
				"js/polykit-notices.js",
				"js/polykit-bulk.js",
				"js/polykit-column.js",
				"js/polykit-meta.js",
				"js/polykit-consistency.js",
				"js/polykit-checks.js",
				"js/polykit-search.js",
				"js/polykit-bulk-consistency.js",
				"js/polykit-settings.js",
				"js/jquery.bind-first.js",
				"js/dompurify.js",
				"CHANGELOG.md",
				"css/common.css",
				"css/translation.css",
				"css/settings.css",
				"css/wp-plugins.css",
				"js/init.js"
			],
			"matches": [
				"*://translate.wordpress.org/*"
			]
		}
	]
}
