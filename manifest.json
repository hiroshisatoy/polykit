{
  "manifest_version": 3,
  "name": "PolyKit",
  "version": "1.0.0",
  "description": "translate.wordpress.org 向け日本語翻訳ツールキット",
  "homepage_url": "https://github.com/hiroshisatoy/polykit",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "js": [
        "js/init.js"
      ],
      "css": [
        "css/style.css"
      ],
      "matches": [
        "*://translate.wordpress.org/*"
      ]
    }
  ],
  "host_permissions": [
    "*://translate.wordpress.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/polykit-locales.js",
        "js/polykit.js",
        "js/polykit-functions.js",
        "js/polykit-hotkey.js",
        "js/polykit-validation.js",
        "js/polykit-locale-validation.js",
        "js/polykit-i18n.js",
        "js/polykit-gp-l10n.js",
        "languages/*/*.json",
        "js/polykit-notices.js",
        "js/polykit-bulk.js",
        "js/polykit-column.js",
        "js/polykit-meta.js",
        "js/polykit-consistency.js",
        "js/polykit-settings.js",
        "js/keymaster.js",
        "js/jquery.bind-first.js",
        "js/dompurify.js",
        "CHANGELOG.md",
        "icons/icon-48.png",
        "css/style.css",
        "js/init.js"
      ],
      "matches": [
        "*://translate.wordpress.org/*"
      ]
    }
  ]
}
